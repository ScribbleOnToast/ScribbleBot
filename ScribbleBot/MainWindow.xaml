<Window x:Class="ScribbleBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScribbleBot"
        xmlns:localBehaviors="clr-namespace:ScribbleBot.ViewModels"
        mc:Ignorable="d"
        Title="ScribbleBot Studio" Height="650" Width="900"
        Background="#1E1E1E" Foreground="#F1F1F1">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Header/Status Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Chat Message List -->
            <RowDefinition Height="*"/>
            <!-- User Input Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status Header Bar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10,8" CornerRadius="4" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status: " FontWeight="Bold" Foreground="#888888"/>
                <TextBlock Text="{Binding State.StatusMessage}" Foreground="#007ACC" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Chat History Box -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                      localBehaviors:AutoScrollBehavior.AutoScroll="True">
            <ItemsControl ItemsSource="{Binding State.Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="10" CornerRadius="6" Background="#252526">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="Bold" Foreground="#569CD6" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#DCDCDC" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input Box and Send Button -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" 
                     Padding="8" FontSize="14" Background="#252526" Foreground="#FFFFFF" 
                     BorderBrush="#3F3F46" VerticalContentAlignment="Center" Margin="0,0,10,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="1" 
                    Content="Send" 
                    Command="{Binding SendMessageCommand}" 
                    Padding="20,8" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#007ACC"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="4" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover State -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1C97EA"/>
                                        </Trigger>
                                        <!-- Disabled State (While Agent is Thinking) -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#333337"/>
                                            <Setter Property="Foreground" Value="#656565"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>